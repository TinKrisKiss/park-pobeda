<div class="booking-widget card" style="margin: 2rem auto; max-width: 800px; text-align: center;">
  <h3 style="color: var(--primary); margin-bottom: 1rem;">Забронировать беседку</h3>
  <form style="display: flex; flex-direction: column; gap: 1rem; align-items: center;">
    <label for="booking-date" style="font-weight: 500;">Выберите дату:</label>
    <input type="date" id="booking-date" required style="padding: 0.8rem; border: 1px solid #ddd; border-radius: 6px; width: 100%; max-width: 300px;">
    <button type="submit" class="btn" style="width: 100%; max-width: 300px;">Забронировать</button>
  </form>
  <p style="font-size: 0.85rem; color: var(--text); opacity: 0.7; margin-top: 1rem;">
    *Интеграция с TravelLine будет подключена позже
  </p>
</div>