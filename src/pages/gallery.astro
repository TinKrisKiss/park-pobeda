---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Галерея">
  <div class="container" style="padding-top: 2rem;">
    <h1 style="text-align: center; margin-bottom: 2rem;">Галерея парка</h1>
    
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
      <!-- Заглушки для фото. Замени src на реальные пути к фото из public/images -->
      <img src="https://placehold.co/600x400/2B4C3A/F5F4F1?text=Беседки" alt="Беседки" style="width: 100%; border-radius: 8px;">
      <img src="https://placehold.co/600x400/2B4C3A/F5F4F1?text=Кафе" alt="Кафе" style="width: 100%; border-radius: 8px;">
      <img src="https://placehold.co/600x400/2B4C3A/F5F4F1?text=Бассейн" alt="Бассейн" style="width: 100%; border-radius: 8px;">
      <img src="https://placehold.co/600x400/2B4C3A/F5F4F1?text=Зимний+парк" alt="Зима" style="width: 100%; border-radius: 8px;">
    </div>
  </div>
</BaseLayout>