---
import BaseLayout from '../layouts/BaseLayout.astro';

const galleries = [
  { slug: 'royal-beach', title: 'Royal Beach', img: 'https://placehold.co/600x400/2B4C3A/F5F4F1?text=Royal+Beach' },
  { slug: 'cafe-shale', title: 'Кафе Шале', img: 'https://placehold.co/600x400/2B4C3A/F5F4F1?text=Кафе+Шале' },
  { slug: 'banquet-hall', title: 'Банкетный зал', img: 'https://placehold.co/600x400/2B4C3A/F5F4F1?text=Банкетный+зал' },
  { slug: 'winter-park', title: 'Зимняя горка и каток', img: 'https://placehold.co/600x400/2B4C3A/F5F4F1?text=Зимний+парк' },
];
---

<BaseLayout title="Галерея">
  <div class="container" style="padding-top: 2rem;">
    <h1 style="text-align: center; margin-bottom: 2rem;">Галерея парка</h1>
    
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
      {galleries.map((item) => (
        <a href={`/park-pobeda/gallery/${item.slug}/`} class="card" style="display: block; padding: 0; overflow: hidden; text-decoration: none; color: inherit;">
          <img src={item.img} alt={item.title} style="width: 100%; height: 200px; object-fit: cover; display: block;">
          <div style="padding: 1rem; text-align: center; font-weight: 500;">{item.title}</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>