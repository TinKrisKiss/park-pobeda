---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Меню кафе">
  <section style="text-align: center; padding: 2rem 0;">
    <h1 style="color: var(--primary); margin-bottom: 1rem;">Меню кафе «Шале»</h1>
    <p style="margin-bottom: 2rem;">Шашлык на углях, пицца, напитки и другие блюда ждут вас!</p>
    <div class="grid" style="max-width: 900px; margin: 0 auto;">
      <img src="https://placehold.co/400x600/2B4C3A/F5F4F1?text=Меню+напитков" alt="Напитки" style="width: 100%; border-radius: 8px;">
      <img src="https://placehold.co/400x600/2B4C3A/F5F4F1?text=Меню+кухни" alt="Кухня" style="width: 100%; border-radius: 8px;">
    </div>
  </section>
</BaseLayout>